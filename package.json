{
  "name": "stamp-tour",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --stream -r run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:push": "pnpm --filter @stamp-tour/server run db:push",
    "db:seed": "pnpm --filter @stamp-tour/server run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "packageManager": "pnpm@10.0.0"
}
